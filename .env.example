PORT=3000
# Public origin for og:url / canonical on shareable profile HTML (P2-16). Optional.
PUBLIC_APP_URL=
NIMIQ_NETWORK=testnet
# Testnet: public RPC from nimiq/awesome (Nimiq Watch; no uptime guarantees).
# Mainnet: https://rpc.nimiqwatch.com
#
# Self-hosted full/archive node (recommended for deeper history or to avoid public
# rate limits): point NIMIQ_RPC_URL at a private JSON-RPC endpoint that exposes the
# methods Steakout uses — especially getTransactionsByAddress with newest-first
# pagination and startAt cursor (see docs/spikes/rpc-reads.md). Use primary =
# private/historical node for indexing; optional public NIMIQ_RPC_URL_FALLBACK.
# After switching RPC, set INDEXER_REBACKFILL=true for one boot only if you need
# deeper history than current cursors; then turn it off.
NIMIQ_RPC_URL=https://rpc.testnet.nimiqwatch.com
# Optional secondary RPC. Used automatically after primary transport retries fail (P3-03).
# Typical pattern: primary = self-hosted archive, fallback = public watch RPC.
NIMIQ_RPC_URL_FALLBACK=
# Official Nimiq validators-api (must match NIMIQ_NETWORK).
# mainnet: https://validators-api-main.je-cf9.workers.dev/api/v1/validators
# testnet: https://validators-api-test.je-cf9.workers.dev/api/v1/validators
# If unset, server picks main/test from NIMIQ_NETWORK. Mis-matched main/test
# worker URLs are overridden with a warning.
VALIDATORS_API_URL=https://validators-api-test.je-cf9.workers.dev/api/v1/validators
# Hourly registry sync into SQLite (P1-04). Set false to disable in local/dev.
VALIDATORS_SYNC_ENABLED=true
VALIDATORS_SYNC_INTERVAL_HOURS=1
RPC_VALIDATOR_ADDRESS=
RPC_ACCOUNT_ADDRESS=
RPC_STAKER_ADDRESS=
RPC_TRANSACTIONS_ADDRESS=
RPC_TRANSACTION_HASH=
RPC_TRANSACTION_CURSOR=
RPC_TRANSACTIONS_MAX=3
RPC_TIMEOUT_MS=10000
RPC_FIXTURE_DIR=tests/fixtures/rpc
DATA_DIR=./data
INDEXER_ENABLED=false
INDEXER_INTERVAL_MINUTES=45
# Comma-separated seed reward addresses (merged with validators.reward_address from DB).
INDEXER_REWARD_ADDRESSES=
# true = only use INDEXER_REWARD_ADDRESSES (ignore DB). Default false.
INDEXER_REWARD_ADDRESSES_ONLY=false
# true = only listed validators from DB (SPEC v1). Set false to include all-observable.
INDEXER_LISTED_ONLY=true
# Deep walk target: stop when txs are older than this many days (default 30).
# Incremental cycles (cursor set) only fetch newer tip activity.
INDEXER_BACKFILL_DAYS=30
# Safety page budget (500 txs/page). Busy addresses may hit this before 30 days.
INDEXER_MAX_PAGES=400
INDEXER_PAGE_SIZE=500
# Concurrent reward addresses (1 is gentlest on public RPC 429s).
INDEXER_ADDRESS_CONCURRENCY=1
# true = clear index_cursors on boot for a full ~BACKFILL_DAYS re-walk (INSERT OR IGNORE keeps txs).
# Turn off after the deep pass finishes so redeploys do not re-walk every boot.
INDEXER_REBACKFILL=false
# Snapshot Steakout canary probe staker accounts (restake/unknown coverage). Default on.
# Skips when probe-roster.public.json network does not match NIMIQ_NETWORK (e.g. local testnet).
# CANARY_SNAPSHOT_ENABLED=false
CANARY_SNAPSHOT_INTERVAL_MINUTES=60
# Precomputed payment floors (weekly tx scan → payment_floors table). Request path is read-only.
# PAYMENT_FLOOR_REFRESH_ENABLED=false
# PAYMENT_FLOOR_REFRESH_DAYS=7
SESSION_SECRET=replace-with-a-long-random-development-secret
# Token for GET /api/diagnostics (Bearer or ?token=). Leave unset to disable the route (503).
DIAGNOSTICS_TOKEN=
CORS_ORIGIN=http://localhost:5173
# Phone-reachable origin for Nimiq Pay QR (LAN IP or tunnel — not localhost).
# Example LAN: VITE_PUBLIC_APP_URL=http://192.168.1.87:5173
# Example Cloudflare quick tunnel (cloudflared tunnel --url http://127.0.0.1:5173):
# PUBLIC_APP_URL=https://your-subdomain.trycloudflare.com
# VITE_PUBLIC_APP_URL=https://your-subdomain.trycloudflare.com
# CORS_ORIGIN=http://localhost:5173,https://your-subdomain.trycloudflare.com
VITE_PUBLIC_APP_URL=
VITE_ENABLE_SDK_SPIKE=false
# Client-visible network label; the app shell shows a badge when this is not "mainnet" (P1-07).
# Also selects Hub + client RPC defaults (testnet → hub.nimiq-testnet.com).
VITE_NIMIQ_NETWORK=testnet
# Optional overrides (leave unset to derive from VITE_NIMIQ_NETWORK):
# VITE_NIMIQ_HUB_URL=https://hub.nimiq-testnet.com
# VITE_NIMIQ_RPC_URL=https://rpc.testnet.nimiqwatch.com
