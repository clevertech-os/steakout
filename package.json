{
  "name": "steakout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Steakout Nimiq staking cockpit scaffold",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "test": "npm run test:server && npm run test:client && npm run test:integration",
    "test:client": "vitest run tests/unit/client",
    "test:server": "vitest run tests/unit/server",
    "test:integration": "vitest run tests/integration",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "smoke": "node scripts/smoke.mjs",
    "probe:accounts": "node scripts/probe-stakes/probe-accounts.mjs",
    "probe:wizard": "node scripts/probe-stakes/probe-accounts.mjs wizard",
    "probe:treasury": "node scripts/probe-stakes/probe-accounts.mjs generate-treasury",
    "probe:stake": "node scripts/probe-stakes/probe-accounts.mjs stake"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vitest": "^3.2.4"
  }
}
